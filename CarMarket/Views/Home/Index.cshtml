@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">

    <div class="hero-content">

        <h1 class="display-3 fw-bold">
            Find Your Next Car
        </h1>

        <p class="lead">
            Browse quality cars and find the right vehicle for you.
        </p>

        <a asp-controller="Cars"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            Browse Cars
        </a>

    </div>

</div>

<hr />

<div class="row text-center mt-5">

    <div class="col-md-4 mb-4">
        <h3>🚗 Wide Selection</h3>
        <p>
            Browse cars from different brands, models and fuel types.
        </p>
    </div>

    <div class="col-md-4 mb-4">
        <h3>🔍 Easy Search</h3>
        <p>
            Search and filter cars by brand, model and fuel type.
        </p>
    </div>

    <div class="col-md-4 mb-4">
        <h3>🔒 Secure Access</h3>
        <p>
            Secure login and role-based access for users and administrators.
        </p>
    </div>

</div>