@using System.Security.Claims
@model IEnumerable<CarMarket.Models.Car>

@{
    ViewData["Title"] = "Browse Cars";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<section class="page-header">
    <div>
        <p class="page-eyebrow">Available vehicles</p>
        <h1 class="page-title">Find your next car</h1>
        <p class="page-subtitle">Search and compare @Model.Count() car listings.</p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add a car</a>
    }
</section>

<form asp-action="Index" method="get" class="search-panel">
    <div class="row g-3">
        <div class="col-lg-5">
            <label for="searchString" class="form-label fw-semibold">Brand or model</label>
            <input id="searchString" type="search" name="searchString"
                   class="form-control" value="@ViewData["CurrentSearch"]" placeholder="For example Audi or A6" />
        </div>

        <div class="col-lg-3">
            <label for="fuelType" class="form-label fw-semibold">Fuel type</label>
            <select id="fuelType" name="fuelType" class="form-select">
                <option value="">All fuel types</option>
                <option value="Petrol" selected="@(ViewData["CurrentFuelType"]?.ToString() == "Petrol")">Petrol / Bensin</option>
                <option value="Diesel" selected="@(ViewData["CurrentFuelType"]?.ToString() == "Diesel")">Diesel</option>
                <option value="Hybrid" selected="@(ViewData["CurrentFuelType"]?.ToString() == "Hybrid")">Hybrid</option>
                <option value="Electric" selected="@(ViewData["CurrentFuelType"]?.ToString() == "Electric")">Electric</option>
            </select>
        </div>

        <div class="col-lg-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>

        <div class="col-lg-2 d-flex align-items-end">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </div>
</form>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="car-card">
                    <div class="car-image-wrap">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl)
                                              ? "/images/car-images-coming-soon.svg"
                                              : item.ImageUrl)"
                             class="car-image"
                             alt="@item.Brand @item.Model" />
                        <span class="car-badge">@item.FuelType</span>
                    </div>

                    <div class="car-card-body">
                        <h2 class="car-card-title">@item.Brand @item.Model</h2>
                        <p class="car-card-price">@item.Price.ToString("N0") kr</p>

                        <div class="car-specs">
                            <div class="car-spec">
                                <strong>@item.Year</strong>
                                Year
                            </div>
                            <div class="car-spec">
                                <strong>@item.Mileage.ToString("N0")</strong>
                                Kilometres
                            </div>
                            <div class="car-spec">
                                <strong>@item.FuelType</strong>
                                Fuel
                            </div>
                        </div>

                        <div class="car-card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-primary">View details</a>

                            @if (User.IsInRole("Admin") || item.SellerId == currentUserId)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-outline-danger">Delete</a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <h2>No cars found</h2>
        <p class="text-muted">Try another brand, model or fuel type.</p>
        <a asp-action="Index" class="btn btn-primary">Show all cars</a>
    </div>
}
